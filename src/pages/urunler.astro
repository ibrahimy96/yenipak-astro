---
import Layout from "../layouts/Layout.astro";

const products = [
  { name: "POLICAST", sub: "CPP Filmler", slug: "policast" },
  { name: "POLIMET", sub: "Metalize Filmler", slug: "polimet" },
  { name: "POLIKAP", sub: "Kaplı Filmler", slug: "polikap" },
  { name: "POLIBARR", sub: "Bariyer Filmler", slug: "polibarr" },
  { name: "POLIMAGIC", sub: "Holografik Filmler", slug: "polimagic" },
  { name: "POLISTRIP", sub: "Açma Şeritleri", slug: "polistrip" },
  { name: "POLINEX", sub: "Koekstrude Filmler", slug: "polinex" },
  { name: "PILEN", sub: "Yalın Filmler", slug: "pilen" },
  { name: "POLIPER", sub: "Pearlize Filmler", slug: "poliper" },
  { name: "POLILABEL", sub: "Etiket Filmleri", slug: "polilabel" },
  { name: "ÜST FİLMLER", sub: "Sabit ve Kolay Açılabilen", slug: "ust-filmler" },
  { name: "POLIPET", sub: "Polyester Film", slug: "polipet" },
  { name: "SHRINK FILMLER", sub: "PVC - PET Shrink", slug: "shrink" },
];
---

<Layout title="Ürünler" activePage="urunler">
  <div class="page-hero">
    <h1>Ürün Grupları</h1><p>
      Polinas A.Ş. ana bayii olarak geniş ürün yelpazemiz
    </p>
  </div>
  <section class="section">
    <div class="section-inner">
      <h2 class="section-title">Ürün Grupları</h2>
      <div class="products-grid">
        {
          products.map((p) => (
            <a href={`/urunler/${p.slug}`} class="product-card">
              <img src={`/images/products/${p.slug}.png`} alt={p.name} />
              <div class="product-card-label">
                {p.name}
                <br />
                <span class="product-sub">{p.sub}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #0e4a8a 0%, #1a5fa8 50%, #2a7fd4 100%);
    padding: 60px 24px;
    text-align: center;
    position: relative;
  }
  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: url("/images/hero-bg.jpg")
      center/cover no-repeat;
    opacity: 0.15;
  }
  .page-hero h1 {
    position: relative;
    font-family: "Montserrat", sans-serif;
    font-size: 42px;
    font-weight: 800;
    color: var(--white);
    margin-bottom: 16px;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  }
  .page-hero p {
    position: relative;
    color: rgba(255, 255, 255, 0.9);
    font-size: 16px;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .product-hero-images {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    margin-bottom: 48px;
  }
  .product-hero-images img {
    width: 100%;
    height: 130px;
    object-fit: cover;
    border-radius: 8px;
  }
  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .product-card {
    background: var(--white);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.07);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
    text-align: center;
    text-decoration: none;
    display: block;
    border: 1px solid var(--border);
  }
  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(26, 95, 168, 0.13);
    border-color: var(--blue);
  }
  .product-card img {
    width: 100%;
    height: 120px;
    object-fit: contain;
    padding: 20px;
    background: var(--gray-bg);
  }
  .product-card-label {
    padding: 16px 14px;
    font-family: "Montserrat", sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: var(--blue-dark);
    line-height: 1.4;
  }
  .product-sub {
    color: var(--text-light);
    font-weight: 400;
    font-size: 12px;
  }

  @media (max-width: 1000px) {
    .products-grid {
      grid-template-columns: 1fr 1fr;
    }
    .product-hero-images {
      grid-template-columns: repeat(3, 1fr);
    }
    .page-hero h1 {
      font-size: 32px;
    }
  }
  @media (max-width: 640px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
    .product-hero-images {
      grid-template-columns: 1fr 1fr;
    }
    .page-hero h1 {
      font-size: 28px;
    }
    .page-hero p {
      font-size: 14px;
    }
  }
</style>
