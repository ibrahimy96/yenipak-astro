---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

export const prerender = true;

const variants = [
  {
    code: 'P',
    image: 'p.png',
    description: 'P çift yönde gerdirilmiş plain polyester (BOPET) filmidr.',
