---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";

export const prerender = true;

const variants = [
  {
    code: "X026",
    image: "x026.png",
    description:
      "Yatay paketleme makineleri için tek tarafı PVdC kaplı şeffaf BOPP film.",
    features: [
      "Kaplama yapılmamış yüzeye baskı yapılabilir",
      "Mükemmel nem, oksijen ve aroma bariyeri",
      "Mükemmel parlaklık ve şeffaflık",
      "PVdC kaplı tarafta Hot tack özelliği ve mükemmel ısıl yapışma",
      "Bisküvi, kraker ve kekler için ideal paketleme filmi",
    ],
    thickness: "31, 38",
  },
  {
    code: "B050",
    image: "b050.png",
    description:
      "Klorin içermeyen, baskıya uygun, ısıl yapışmalı, yüksek bariyerli şeffaf BOPP baskı ve laminasyon filmi",
    features: [
      "Bariyer özellik gerektiren genel paketleme uygulamaları için ideal (patates cipsleri, kahve, kraker ve gofret ambalajları gibi)",
      "Mükemmel tokluk",
      "Yüksek oksijen ve nem bariyeri",
    ],
    thickness: "16, 21",
  },
  {
    code: "B051",
    image: "b051.png",
    description:
      "Klorin içermeyen, baskıya uygun, yüksek bariyerli şeffaf BOPP baskı ve laminasyon filmi",
    features: [
      "Bariyer özellik gerektiren genel paketleme uygulamaları için ideal (patates cipsleri, kahve, kraker ve gofret ambalajları gibi)",
      "Mükemmel tokluk",
      "Yüksek oksijen ve nem bariyeri",
      "Koronalı yüzey soğuk tutkal uygulamalarına uygun",
    ],
    thickness: "16, 21",
  },
  {
    code: "B030",
    image: "b030.png",
    description:
      "Klorin içermeyen ,baskı ya uygun, yüksek bariyerli şeffaf BOPET baskı ve laminasyon filmi",
    features: [
      "Bariyer özellik gerektiren genel paketleme uygulamalarına yönelik baskı, laminasyon proseslerinde kullanıma uygundur",
      "Mükemmel tokluk",
      "Yüksek oksijen bariyeri",
      "İyi adhezyon ve korona seviyesi için tavsiye edilen raf ömrü süresi 1 yıldır",
    ],
    thickness: "13",
  },
  {
    code: "CC26",
    image: "cc26.png",
    description:
      "Yatay ve dikey paketleme makineleri için, iki yüzeyi akrilik kaplı şeffaf BOPP film",
    features: [
      "Mükemmel nem, oksijen ve aroma bariyeri",
      "Mükemmel parlaklık ve şeffaflık",
      "Sadece tek kat yapılarda kullanıma uygundur",
      "Flexo ve rotogravür baskılar da mükemmel mürekkep adezyonu",
    ],
    thickness: "30",
  },
  {
    code: "PSA",
    image: "psa.png",
    description:
      "PSA, bir tarafı PVdC kaplı çift yönde gerdirilmiş polyester(BOPET) ambalaj filmidir.",
    features: [
      "Laminasyon ve PVdC ye uygun mürekkepler ile baskı için dizayn edilmiştir",
      "PVdC kaplı taraf ısıl yapışmalıdır",
      "Mükemmel nem, oksijen ve aroma bariyeri",
      "Laminasyon sonrası pastorizasyonda mükemmel ısı ve nem direnci (PVdC taraf lamine edilmelidir)",
    ],
    thickness: "12, 14",
  },
];
---

<Layout title="POLIKAP - Kaplı Filmler" activePage="urunler">
  <div class="page-hero">
    <Image
      src="/images/products/polikap.webp"
      alt="POLIKAP"
      class="page-hero-image"
      width={168}
      height={168}
    />
    <div class="hero-content">
      <h1>POLIKAP</h1>
      <p>Kaplı Filmler</p>
    </div>
  </div>

  <section class="section">
    <div class="section-inner">
      <div class="product-intro">
        <Image
          src="/images/products/polikap-header-1.webp"
          alt="POLIKAP"
          class="product-intro-image"
          width={168}
          height={168}
        />
        <Image
          src="/images/products/polikap-header-2.webp"
          alt="POLIKAP"
          class="product-intro-image-secondary"
          width={200}
          height={200}
        />
        <p>
          Gıda ambalajları için yüksek bariyerli, ısıl yapışmalı veya soğuk
          tutkal uygulamalarına uygun metalize koeks veya yüksek verimli kavite
          edilmiş filmler.
        </p>
      </div>

      <div class="variants-list">
        {
          variants.map((variant) => (
            <div class="variant-card">
              <div class="variant-header">
                <h2>{variant.code}</h2>
                {variant.image && (
                  <Image
                    src={`/images/products/${variant.image.replace(".png", ".webp")}`}
                    alt={variant.code}
                    class="variant-image"
                    width={150}
                    height={150}
                  />
                )}
              </div>
              <p class="variant-description">{variant.description}</p>
              <h3>Özellikleri ve Kullanım alanları:</h3>
              <ul>
                {variant.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <p class="thickness">
                <strong>Üretilen Kalınlıklar (mikron):</strong>{" "}
                {variant.thickness}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #0e4a8a 0%, #1a5fa8 50%, #2a7fd4 100%);
    padding: 60px 24px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
  }
  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: url("/images/hero-bg.jpg") center/cover no-repeat;
    opacity: 0.15;
  }
  .page-hero-image,
  .product-intro-image,
  .product-intro-image-secondary {
    position: relative;
    height: auto;
    object-fit: contain;
  }
  .page-hero-image {
    width: 168px;
  }
  .product-intro-image {
    width: 168px;
  }
  .product-intro-image-secondary {
    width: 200px;
  }
  .hero-content {
    position: relative;
    text-align: left;
  }
  .hero-content h1 {
    font-family: "Montserrat", sans-serif;
    font-size: 42px;
    font-weight: 800;
    color: var(--white);
    margin-bottom: 8px;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  }
  .hero-content p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 18px;
    line-height: 1.4;
  }
  .product-intro {
    background: var(--gray-bg);
    padding: 32px;
    border-radius: 10px;
    margin-bottom: 48px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .product-intro p {
    font-size: 16px;
    line-height: 1.6;
    flex: 1;
  }
  .variants-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .variant-card {
    background: var(--white);
    border-radius: 10px;
    padding: 32px;
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.07);
  }
  .variant-card h2 {
    color: var(--blue-dark);
    font-size: 28px;
    margin-bottom: 16px;
  }
  .variant-header {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 20px;
  }
  .variant-image {
    width: 150px;
    height: auto;
    object-fit: contain;
  }
  .variant-description {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 20px;
    color: var(--text-color);
  }
  .variant-card h3 {
    color: var(--blue-dark);
    font-size: 18px;
    margin-bottom: 12px;
  }
  .variant-card ul {
    margin-left: 20px;
    margin-bottom: 16px;
  }
  .variant-card li {
    margin-bottom: 8px;
    line-height: 1.6;
  }
  .thickness {
    color: var(--text-light);
    font-size: 14px;
  }
  @media (max-width: 768px) {
    .page-hero {
      flex-direction: column;
      text-align: center;
    }
    .hero-content {
      text-align: center;
    }
    .page-hero-image {
      width: 150px;
    }
    .hero-content h1 {
      font-size: 32px;
    }
  }
</style>
