---

<Layout title="POLILABEL - Etiket Filmleri" activePage="urunler">
  <div class="page-hero">
    <Image src="/images/products/polilabel.webp" alt="POLILABEL" class="hero-image" width={133} height={133} />
    <div class="hero-content">
      <h1>POLILABEL</h1>
      <p>Etiket Filmleri</p>
    </div>
  </div>
  
  <section class="section">
    <div class="section-inner">
      <div class="product-intro">
        <Image src="/images/products/polilabel-header-1.webp" alt="POLILABEL" class="hero-image" width={133} height={133} />
        <Image src="/images/products/polilabel-header-2.webp" alt="POLILABEL" class="hero-image-secondary" width={168} height={168} />
        <Image src="/images/products/polilabel-header-3.webp" alt="POLILABEL" class="hero-image-tertiary" width={168} height={168} />
        <p>Çeşitli etiketleme uygulamalarına yönelik etiket filmleri:</p>
        <ul>
          <li>Bobin veya magazin beslemeli etiket uygulamaları</li>
          <li>Kendinden yapışkanlı etiket uygulamaları</li>
          <li>Kes & demetle uygulamaları</li>
          <li>Kalıp içi etiketleme uygulamaları</li>
        </ul>
      </div>

      <div class="variants-list">
        {variants.map(variant => (
          <div class="variant-card">
            <div class="variant-header">
              <h2>{variant.code}</h2>
              {variant.image && <Image src={`/images/products/${variant.image.replace('.png', '.webp')}`} alt={variant.code} class="variant-image" width={150} height={150} />}
            </div>
            <p class="variant-description">{variant.description}</p>
            <h3>Özellikleri ve Kullanım alanları:</h3>
            <ul>
              {variant.features.map(feature => (
                <li>{feature}</li>
              ))}
            </ul>
            <p class="thickness"><strong>Üretilen Kalınlıklar (mikron):</strong> {variant.thickness}</p>
            {variant.note && <p class="note"><strong>Not:</strong> {variant.note}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #0e4a8a 0%, #1a5fa8 50%, #2a7fd4 100%);
    padding: 60px 24px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/hero-bg.jpg') center/cover no-repeat;
    opacity: 0.15;
  }
  .hero-image {
    position: relative;
    width: 133px;
    height: auto;
    object-fit: contain;
  }
  .hero-image-secondary {
    position: relative;
    width: 168px;
    height: auto;
    object-fit: contain;
  }
  .hero-image-tertiary {
    position: relative;
    width: 168px;
    height: auto;
    object-fit: contain;
  }
  .hero-content {
    position: relative;
    text-align: left;
  }
  .hero-content h1 {
    font-family: 'Montserrat', sans-serif;
    font-size: 42px;
    font-weight: 800;
    color: var(--white);
    margin-bottom: 8px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.3);
  }
  .hero-content p {
    color: rgba(255,255,255,0.9);
    font-size: 18px;
    line-height: 1.4;
  }
  .product-intro {
    background: var(--gray-bg);
    padding: 32px;
    border-radius: 10px;
    margin-bottom: 48px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .product-intro p {
    font-size: 16px;
    line-height: 1.6;
    flex: 1;
    margin-bottom: 16px;
  }
  .product-intro ul {
    margin-left: 20px;
  }
  .product-intro li {
    margin-bottom: 8px;
    line-height: 1.6;
  }
  .variants-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .variant-card {
    background: var(--white);
    border-radius: 10px;
    padding: 32px;
    box-shadow: 0 3px 14px rgba(0,0,0,0.07);
  }
  .variant-card h2 {
    color: var(--blue-dark);
    font-size: 28px;
    margin-bottom: 16px;
  }
  .variant-header {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 20px;
  }
  .variant-image {
    width: 150px;
    height: auto;
    object-fit: contain;
  }
  .variant-description {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 20px;
    color: var(--text-color);
  }
  .variant-card h3 {
    color: var(--blue-dark);
    font-size: 18px;
    margin-bottom: 12px;
  }
  .variant-card ul {
    margin-left: 20px;
    margin-bottom: 16px;
  }
  .variant-card li {
    margin-bottom: 8px;
    line-height: 1.6;
  }
  .thickness {
    color: var(--text-light);
    font-size: 14px;
    margin-bottom: 8px;
  }
  .note {
    color: var(--text-color);
    font-size: 13px;
    font-style: italic;
    background: var(--gray-bg);
    padding: 12px;
    border-radius: 6px;
  }
  @media (max-width: 768px) {
    .page-hero {
      flex-direction: column;
      text-align: center;
    }
    .hero-content {
      text-align: center;
    }
    .hero-image {
      width: 150px;
    }
    .hero-content h1 {
      font-size: 32px;
    }
  }
</style>
