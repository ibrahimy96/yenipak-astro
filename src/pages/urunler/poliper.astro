---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

export const prerender = true;

const variants = [
  {
    code: '414',
    image: '414.png',
    description: 'Verim değeri yüksek, her iki tarafı ısıl yapışmalı gıda ambalajları için pearlize BOPP film.',
    features: [
      'Tek tarafı koronalı',
      'Düşük yoğunlukta yüksek verimli',
      'Beyaz mürekkep kullanımını azaltan ekonomik film',
      'Tek kat veya laminasyon uygulamalarında kullanıma uygun'
    ],
    thickness: '30, 35, 40'
  },
  {
    code: '424',
    image: '424.png',
    description: 'Verim değeri yüksek, ısıl yapışmasız gıda ambalajları için pearlize BOPP film.',
    features: [
      'İki tarafı koronalı',
      'Düşük yoğunlukta yüksek verimli',
      'Düz baskı, laminasyon ve soğuk tutkal uygulamalarında ideal film',
      'Beyaz mürekkep kullanımını azaltan ekonomik bir film',
      'Tek kat yapı veya laminasyon uygulamalarında kullanıma uygun'
    ],
    thickness: '30, 35, 40, 50'
  },
  {
    code: '417B',
    image: '417b.png',
    description: 'Verim degeri yüksek, her iki tarafı ısıl yapısmalı, gıda ambalajları için yüksek parlaklıkta pearlize BOPP film',
    features: [
      'Tek tarafı (parlak yüzey) koronalı',
      'Düşük yoğunlukta yüksek verimli',
      'Mükemmel parlaklık ve opasite',
      'Özel soguk tutkallar koronasız yüzeye uygulanabilir',
      'İki tarafı ısıl yapısmalı'
    ],
    thickness: '28, 35, 40'
  },
  {
    code: '415VWB',
    image: '415vwb.png',
    description: 'Gıda ve şeker ambalajları için beyaz pearlize; çift tarafı ısıl yapışmalı, tek tarafı co-extrude LTS (düşük ısıl yapışmalı)BOPP film',
    features: [
      'Tek tarafı (parlak yüzey) koronalı',
      'Düşük yoğunluk, yüksek verim',
      'Mükemmel opaklık, parlaklık ve düşük ışık geçirgenliği',
      'Yüksek hızlı paketleme makineleri için ideal'
    ],
    thickness: '25, 28, 30, 35, 40'
  },
  {
    code: 'MRGX1',
    image: 'mrgx1.png',
    description: 'Margarin ambalajı için pearlize BOPP film',
    features: [
      'Tek tarafı koronalı',
      'Yüksek verim',
      'Mükemmel baskı ve paketleme performansı',
      'Yüksek parlaklık',
      'FDA ve EC gıda ile temas standartlarına uygundur'
    ],
    thickness: '75'
  }
];
---

<Layout title="POLIPER - Pearlize Filmler" activePage="urunler">
  <div class="page-hero">
    <Image src="/images/products/poliper.webp" alt="POLIPER" class="hero-image" width={168} height={168} />
    <div class="hero-content">
      <h1>POLIPER</h1>
      <p>Pearlize Filmler</p>
    </div>
  </div>
  
  <section class="section">
    <div class="section-inner">
      <div class="product-intro">
        <Image src="/images/products/poliper-header-1.webp" alt="POLIPER" class="hero-image" width={168} height={168} />
        <Image src="/images/products/poliper-header-2.webp" alt="POLIPER" class="hero-image-secondary" width={240} height={240} />
        <Image src="/images/products/poliper-header-3.webp" alt="POLIPER" class="hero-image-tertiary" width={168} height={168} />
        <p>Film-film, film-kağıt, film-karton laminasyonu uygulamaları için ısıl yapışmasız, şeffaf, mat veya beyaz, tek veya çift tarafı koronalı filmlerdir.</p>
        <ul>
          <li>Pearlize, çift yüzeyi ısıl yapışmalı, tek yüzeyi koronalı BOPP film</li>
          <li>Soğuk tutkal uygulamaları için, pearlize, ısıl yapışmasız, çift yüzeyi koronalı BOPP film</li>
          <li>Gıda ambalajları için, pearlize, çift yüzeyi ısıl yapışmalı, yüksek parlaklıkta, tek yüzeyi koronalı BOPP film</li>
          <li>Gıda ve şeker ambalajları için, beyaz pearlize, çift yüzeyi ısıl yapışmalı (tek yüzeyi düşük ısıl yapışmalı, LTS), tek yüzeyi koronalı BOPP film</li>
          <li>Margarin ambalajları için, pearlize, yüksek verimli, ısıl yapışmasız, tek yüzeyi koronalı BOPP film</li>
        </ul>
      </div>

      <div class="variants-list">
        {variants.map(variant => (
          <div class="variant-card">
            <div class="variant-header">
              <h2>{variant.code}</h2>
              {variant.image && <Image src={`/images/products/${variant.image.replace('.png', '.webp')}`} alt={variant.code} class="variant-image" width={150} height={150} />}
            </div>
            <p class="variant-description">{variant.description}</p>
            <h3>Özellikleri ve Kullanım alanları:</h3>
            <ul>
              {variant.features.map(feature => (
                <li>{feature}</li>
              ))}
            </ul>
            <p class="thickness"><strong>Üretilen Kalınlıklar (mikron):</strong> {variant.thickness}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #0e4a8a 0%, #1a5fa8 50%, #2a7fd4 100%);
    padding: 60px 24px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/hero-bg.jpg') center/cover no-repeat;
    opacity: 0.15;
  }
  .hero-image {
    position: relative;
    width: 168px;
    height: auto;
    object-fit: contain;
  }
  .hero-image-secondary {
    position: relative;
    width: 240px;
    height: auto;
    object-fit: contain;
  }
  .hero-image-tertiary {
    position: relative;
    width: 168px;
    height: auto;
    object-fit: contain;
  }
  .hero-content {
    position: relative;
    text-align: left;
  }
  .hero-content h1 {
    font-family: 'Montserrat', sans-serif;
    font-size: 42px;
    font-weight: 800;
    color: var(--white);
    margin-bottom: 8px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.3);
  }
  .hero-content p {
    color: rgba(255,255,255,0.9);
    font-size: 18px;
    line-height: 1.4;
  }
  .product-intro {
    background: var(--gray-bg);
    padding: 32px;
    border-radius: 10px;
    margin-bottom: 48px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .product-intro p {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 16px;
    flex: 1;
  }
  .product-intro ul {
    margin-left: 20px;
  }
  .product-intro li {
    margin-bottom: 8px;
    line-height: 1.6;
  }
  .variants-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .variant-card {
    background: var(--white);
    border-radius: 10px;
    padding: 32px;
    box-shadow: 0 3px 14px rgba(0,0,0,0.07);
  }
  .variant-card h2 {
    color: var(--blue-dark);
    font-size: 28px;
    margin-bottom: 16px;
  }
  .variant-header {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 20px;
  }
  .variant-image {
    width: 150px;
    height: auto;
    object-fit: contain;
  }
  .variant-description {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 20px;
    color: var(--text-color);
  }
  .variant-card h3 {
    color: var(--blue-dark);
    font-size: 18px;
    margin-bottom: 12px;
  }
  .variant-card ul {
    margin-left: 20px;
    margin-bottom: 16px;
  }
  .variant-card li {
    margin-bottom: 8px;
    line-height: 1.6;
  }
  .thickness {
    color: var(--text-light);
    font-size: 14px;
  }
  @media (max-width: 768px) {
    .page-hero {
      flex-direction: column;
      text-align: center;
    }
    .hero-content {
      text-align: center;
    }
    .hero-image {
      width: 150px;
    }
    .hero-content h1 {
      font-size: 32px;
    }
  }
</style>
