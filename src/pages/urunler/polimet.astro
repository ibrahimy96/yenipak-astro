---

<Layout title="POLIMET - Metalize Filmler" activePage="urunler">
  <div class="page-hero">
    <Image src="/images/products/polimet.webp" alt="POLIMET" class="hero-image" width={188} height={188} />
    <div class="hero-content">
      <h1>POLIMET</h1>
      <p>Metalize Filmler</p>
    </div>
  </div>

  <section class="section">
    <div class="section-inner">
      <div class="product-intro">
        <Image src="/images/products/polimet-header-1.webp" alt="POLIMET" class="hero-image" width={188} height={188} />
        <Image src="/images/products/polimet-header-2.webp" alt="POLIMET" class="hero-image-secondary" width={120} height={120} />
        <p>Gıda ambalajları için yüksek bariyerli, ısıl yapışmalı veya soğuk tutkal uygulamalarına uygun metalize koeks veya yüksek verimli kavite edilmiş filmler.</p>
      </div>

      <div class="variants-list">
        {variants.map(variant => (
          <div class="variant-card">
            <div class="variant-header">
              <h2>{variant.code}</h2>
              {variant.image && <Image src={`/images/products/${variant.image.replace('.png', '.webp')}`} alt={variant.code} class="variant-image" width={150} height={150} />}
            </div>
            <p class="variant-description">{variant.description}</p>
            <h3>Özellikleri ve Kullanım alanları:</h3>
            <ul>
              {variant.features.map(feature => (
                <li>{feature}</li>
              ))}
            </ul>
            <p class="thickness"><strong>Üretilen Kalınlıklar (mikron):</strong> {variant.thickness}</p>
            {variant.note && <p class="note"><strong>Not:</strong> {variant.note}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #0e4a8a 0%, #1a5fa8 50%, #2a7fd4 100%);
    padding: 60px 24px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('https://static.wixstatic.com/media/d948a3_c9ba26606c5f46e68093f29b42c3db1c~mv2.jpg/v1/fill/w_980,h_425,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/d948a3_c9ba26606c5f46e68093f29b42c3db1c~mv2.jpg') center/cover no-repeat;
    opacity: 0.15;
  }
  .hero-image {
    position: relative;
    width: 188px;
    height: auto;
    object-fit: contain;
  }
  .hero-image-secondary {
    position: relative;
    width: 120px;
    height: auto;
    object-fit: contain;
  }
  .hero-content {
    position: relative;
    text-align: left;
  }
  .hero-content h1 {
    font-family: 'Montserrat', sans-serif;
    font-size: 42px;
    font-weight: 800;
    color: var(--white);
    margin-bottom: 8px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.3);
  }
  .hero-content p {
    color: rgba(255,255,255,0.9);
    font-size: 18px;
    line-height: 1.4;
  }
  .product-intro {
    background: var(--gray-bg);
    padding: 32px;
    border-radius: 10px;
    margin-bottom: 48px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .product-intro p {
    font-size: 16px;
    line-height: 1.6;
    flex: 1;
  }
  .variants-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .variant-card {
    background: var(--white);
    border-radius: 10px;
    padding: 32px;
    box-shadow: 0 3px 14px rgba(0,0,0,0.07);
  }
  .variant-card h2 {
    color: var(--blue-dark);
    font-size: 28px;
    margin-bottom: 16px;
  }
  .variant-header {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 20px;
  }
  .variant-image {
    width: 150px;
    height: auto;
    object-fit: contain;
  }
  .variant-description {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 20px;
    color: var(--text-color);
  }
  .variant-card h3 {
    color: var(--blue-dark);
    font-size: 18px;
    margin-bottom: 12px;
  }
  .variant-card ul {
    margin-left: 20px;
    margin-bottom: 16px;
  }
  .variant-card li {
    margin-bottom: 8px;
    line-height: 1.6;
  }
  .thickness {
    color: var(--text-light);
    font-size: 14px;
    margin-bottom: 8px;
  }
  .note {
    color: var(--text-color);
    font-size: 13px;
    font-style: italic;
    background: var(--gray-bg);
    padding: 12px;
    border-radius: 6px;
  }
  @media (max-width: 768px) {
    .page-hero {
      flex-direction: column;
      text-align: center;
    }
    .hero-content {
      text-align: center;
    }
    .hero-image {
      width: 150px;
    }
    .hero-content h1 {
      font-size: 32px;
    }
  }
</style>
</style>
