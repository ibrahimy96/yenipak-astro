---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";

export const prerender = true;

const hologramPatterns = [
  { code: "A0", name: "Gökkuşağı", image: "a0-gokkusagi.jpg" },
  { code: "A1", name: "Noktacıklar", image: "a1-noktaciklar.jpg" },
  { code: "A2", name: "Gonca", image: "a2-gonca.jpg" },
  { code: "A3", name: "Çizgiler", image: "a3-cizgiler.jpg" },
  { code: "A4", name: "Hasır", image: "a4-hasir.jpg" },
  { code: "A5", name: "Rüzgar", image: "a5-ruzgar.jpg" },
  { code: "A6", name: "Yağmur", image: "a6-yagmur.jpg" },
  { code: "A7", name: "Cam Kırığı", image: "a7-cam-kirigi.jpg" },
  { code: "A8", name: "Çubuklar", image: "a8-cubuklar.jpg" },
  { code: "A9", name: "Boncuklar", image: "a9-boncuklar.jpg" },
  { code: "B0", name: "Çizgi Gökkuşağı", image: "b0-cizgi-gokkusagi.jpg" },
  { code: "B1", name: "Yapboz", image: "b1-yapboz.jpg" },
  { code: "B2", name: "Balon", image: "b2-balon.jpg" },
  { code: "B3", name: "Kar Tanesi", image: "b3-kar-tanesi.jpg" },
  { code: "B5", name: "Atom", image: "b5-atom.jpg" },
  { code: "B6", name: "Kum Desen", image: "b6-kum-desen.jpg" },
  { code: "B7", name: "Işık", image: "b7-isik.jpg" },
];
---

<Layout title="POLIMAGIC - Holografik Filmler" activePage="urunler">
  <div class="page-hero">
    <Image
      src="/images/products/polimagic-header.png"
      alt="POLIMAGIC"
      class="hero-image"
      width={120}
      height={171}
    />
    <div class="hero-content">
      <h1>POLIMAGIC</h1>
      <p>Holografik Filmler</p>
    </div>
  </div>

  <section class="section">
    <div class="section-inner">
      <div class="product-intro">
        <p>
          POLIMAGIC Holografik filmler, etkileyici dizaynları ile ürünlerinize
          benzersiz görsel özellikler kazandırır, ürünlerinizin raflardaki
          albenisini arttırır. POLIMAGIC Holografik Filmler, tüm ambalaj
          sektörünün ihtiyacına uygun, çeşitli paketleme sistemlerinde ve paket
          yapılarında sorunsuz çalışacak özelliklerde üretilmektedir.
        </p>
        <p>
          Mükemmel mürekkep adezyonu, bariyer özellikleri ve geniş yelpazedeki
          holografik dizaynları sayesinde ürününüze özgü bir ambalaj ve
          ayrıcalık kazandırır.
        </p>
      </div>

      <div class="variants-list">
        <div class="variant-card">
          <h2>Film Özellikleri</h2>
          <h3>Genel Özellikler:</h3>
          <ul>
            <li>Mükemmel kalite ve yüksek parlaklık</li>
            <li>Ambalajlarınıza yüksek albeni ve estetik görünüş katar</li>
            <li>Benzersiz, üstün tasarım olanakları sunar</li>
            <li>Ürünlerinizin taklit edilmesini önlemede etkin bir çözümdür</li>
            <li>Mükemmel baskı performansı</li>
            <li>Farklı enlerde üretilebilme (1650 mm'ye kadar)</li>
            <li>Talep üzerine özel logo ve tasarımlarda hazırlanabilme</li>
          </ul>

          <h3>Uygulamalar:</h3>
          <ul>
            <li>Gıda ambalajları</li>
            <li>Kağıt-karton ve film laminasyonları</li>
            <li>Kendinden yapışkanlı etiketler</li>
            <li>Bobin beslemeli şişe etiketleri</li>
            <li>Kes-demetle tipi etiketler</li>
            <li>Hediye paketlemesi ve dekoratif ambalajlama</li>
            <li>Güvenlik etiketleri</li>
          </ul>
        </div>

        <div class="variant-card">
          <h2>Hologram Desenleri</h2>
          <p>
            Çeşitli hologram desenleri mevcuttur. İhtiyacınıza uygun desen
            seçimi için bizimle iletişime geçebilirsiniz.
          </p>
          <div class="hologram-grid">
            {
              hologramPatterns.map((pattern) => (
                <figure class="hologram-pattern">
                  <img
                    src={`/images/products/polimagic/${pattern.image}`}
                    alt={`${pattern.code} - ${pattern.name}`}
                    loading="lazy"
                  />
                  <figcaption>
                    {pattern.code} - {pattern.name}
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #0e4a8a 0%, #1a5fa8 50%, #2a7fd4 100%);
    padding: 60px 24px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
  }
  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: url("/images/hero-bg.jpg") center/cover no-repeat;
    opacity: 0.15;
  }
  .hero-image {
    position: relative;
    width: 120px;
    height: auto;
    object-fit: contain;
  }
  .hero-content {
    position: relative;
    text-align: left;
  }
  .hero-content h1 {
    font-family: "Montserrat", sans-serif;
    font-size: 42px;
    font-weight: 800;
    color: var(--white);
    margin-bottom: 8px;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  }
  .hero-content p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 18px;
    line-height: 1.4;
  }
  .product-intro {
    background: var(--gray-bg);
    padding: 32px;
    border-radius: 10px;
    margin-bottom: 48px;
  }
  .product-intro p {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .variants-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .variant-card {
    background: var(--white);
    border-radius: 10px;
    padding: 32px;
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.07);
  }
  .variant-card h2 {
    color: var(--blue-dark);
    font-size: 28px;
    margin-bottom: 16px;
  }
  .variant-card h3 {
    color: var(--blue-dark);
    font-size: 18px;
    margin-bottom: 12px;
    margin-top: 20px;
  }
  .variant-card ul {
    margin-left: 20px;
    margin-bottom: 16px;
  }
  .variant-card li {
    margin-bottom: 8px;
    line-height: 1.6;
  }
  .variant-card p {
    font-size: 16px;
    line-height: 1.6;
  }
  .hologram-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 24px;
  }
  .hologram-pattern {
    margin: 0;
    text-align: center;
  }
  .hologram-pattern img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    object-fit: cover;
  }
  .hologram-pattern figcaption {
    margin-top: 8px;
    color: var(--text-color);
    font-size: 14px;
    line-height: 1.3;
  }
  @media (max-width: 768px) {
    .page-hero {
      flex-direction: column;
      text-align: center;
    }
    .hero-content {
      text-align: center;
    }
    .hero-image {
      width: 150px;
    }
    .hero-content h1 {
      font-size: 32px;
    }
    .hologram-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
