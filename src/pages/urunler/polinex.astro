---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

export const prerender = true;

const variants = [
  {
    code: '114H',
    image: '114h.png',
    description: 'Gıda ambalajları için şeffaf, çift tarafı ısıl yapışmalı BOPP film.',
    features: [
      'Tek tarafı koronalı',
      'Tok yapıda mükemmel parlaklık ve şeffaflık düşük pusluluk',
      'Mükemmel mürekkep adezyonu',
      'Mükemmel hot tack ve ısıl yapışma kuvveti',
      'Tek kat ve laminasyonlu yapılarda kullanıma uygun',
      'Çeşitli paketleme makinelerinde yüksek performans'
    ],
    thickness: '15, 20, 25, 30, 35, 40, 50'
  },
  {
    code: '114HB',
    image: '114hb.png',
    description: 'Gıda ambalajları için beyaz, her iki yüzeyi ısıl yapışmalı BOPP film',
    features: [
      'Tek tarafı koronalı',
      'Mükemmel beyazlık',
      'Tok yapıda mükemmel parlaklık düşük pusluluk',
      'Mükemmel mürekkep adezyonu',
      'Mükemmel hot tack ve ısıl yapışma kuvveti',
      'Tek kat ve laminasyon halinde kullanıma uygun',
      'Çeşitli paketleme makinelerinde yüksek performans',
      'Beyaz mürekkep kullanımını azaltan ekonomik film'
    ],
    thickness: '20, 30'
  },
  {
    code: '114HB2',
    image: '114hb2.png',
    description: 'Gıda ambalajları için beyaz, iki tarafı isıl yapışmalı BOPP film.',
    features: [
      'Tek tarafı koronalı',
      'İdeal beyazlık ve parlaklık',
      'Koronasız tarafta LTS (düşük ısılarda yapışabilme) özelliği',
      'Yüksek paketleme performansı',
      'Tek kat ve laminasyonlu yapılarda kullanıma uygun',
      'Flexo ve rotogravür baskılar da mükemmel mürekkep adezyonu',
      'Beyaz mürekkep kullanımını azaltan, ekonomik film'
    ],
    thickness: '30'
  },
  {
    code: '114HC',
    image: '114hc.png',
    description: 'Tekstil ambalajları için yüksek parlaklıkta düşük puslulukta BOPP film',
    features: [
      'İki tarafı ısıl yapışabilir',
      'Tek tarafı koronalı',
      'Tok yapıda mükemmel parlaklık',
      'Tel kaynak ile yapıştıran makinelerde mükemmel performans',
      'Mükemmel mürekkep adezyonu',
      'Çizilmeye dayanıklı',
      'Tekstil ambalajları için poşet makinelerinde mükemmel performans'
    ],
    thickness: '27, 28, 30'
  },
  {
    code: '114VWH',
    image: '114vwh.png',
    description: 'Gıda ambalajları için şeffaf, çift tarafı ısıl yapışmalı (tek tarafı düşük ısıl yapışmalı LTS) BOPP film.',
    features: [
      'Tek tarafı koronalı',
      'Tek tarafı düşük ısıl yapışmalı (LTS)',
      'Düşük pusluluk',
      'Yüksek parlaklık ve sertlik',
      'Mükemmel mürekkep adezyonu',
      'Mükemmel hot tack özelliği',
      'Mükemmel ısıl yapışma kuvveti',
      'Çok katlı uygulamalarda mükemmel yapışma performansı',
      'Hızlı paketleme makinalarında yüksek performans'
    ],
    thickness: '20, 25'
  },
  {
    code: '115HD',
    image: '115hd.png',
    description: 'Genel uygulamalar için tek tarafı mat görünümlü, ısıl yapışmalı BOPP film',
    features: [
      'Tek (parlak yüzey) tarafı koronalı',
      'MD yönünde düşük uzama özelliği',
      'Mükemmel mat görünümlü yüzey',
      'Ekstrüzyon laminasyon proseslerinde kullanılabilir',
      'Laminasyon ve bant filmi olarak da kullanılabilir',
      'Flexo ve rotogravür baskılar da mükemmel mürekkep adezyonu'
    ],
    thickness: '20, 25'
  },
  {
    code: '119VWBL',
    image: '119vwbl.png',
    description: 'Silindirik gıda ambalajları için beyaz, çift tarafı ısıl yapışmalı (tek tarafı düşük ısıl yapışmalı LTS) BOPP film.',
    features: [
      'Yüksek paketleme performansı',
      'İki tarafı ısıl yapışmalı',
      'Flexo ve rotogravür baskılar da mükemmel mürekkep adezyonu',
      'Tek tarafı koronalı',
      'Mükemmel hot tack ve ısıl yapışma kuvveti',
      'Tek kat ve laminasyonlu yapılarda kullanıma uygun'
    ],
    thickness: '20, 25'
  },
  {
    code: '306',
    image: '306.png',
    description: 'Sıkı sarımlı tekli ve çoklu sigara paketleri için, iki tarafı ısıl yapısmalı, kayganlık ve anti-statik özellikleri gelistirilmis seffaf BOPP film.',
    features: [
      'Koronasız',
      'Tok yapıda mükemmel parlaklık ve seffaflık, düsük pusluluk',
      'Mükemmel hot tack ve ısıl yapısma kuvveti',
      'Yüksek hızlı paketleme makineleri için mükemmel kayganlık, sıcak yüzeylerde kayganlık ve antistatik özellikleri',
      'Toz tutmayan antistatik yüzey',
      'Uygulandığı sigara paketindeki mürekkebin filme çıkmasını önler'
    ],
    thickness: '21'
  },
  {
    code: '124HF',
    image: '124hf.png',
    description: 'Sebze ve meyve paketleri için her iki yüzeyi ısıl yapışmalı şeffaf BOPP antifog film',
    features: [
      'İki tarafı koronalı',
      'İki tarafı ısıl yapışmalı',
      'Tok yapıda mükemmel parlaklık ve şeffaflık, düşük pusluluk',
      'Mükemmel mürekkep adezyonu',
      'Mükemmel hot tack ve ısıl yapışma kuvveti',
      'Tek kat veya laminasyon halinde kullanıma uygun',
      'Üründen gelen su damlacıkları filmin iç yüzeyinde yayılarak, paketin içinin görülmesini sağlar'
    ],
    thickness: '25, 30, 35, 40'
  }
];
---

<Layout title="POLINEX - Koekstrude Filmler" activePage="urunler">
  <div class="page-hero">
    <Image src="/images/products/polinex.webp" alt="POLINEX" class="hero-image" width={168} height={168} />
    <div class="hero-content">
      <h1>POLINEX</h1>
      <p>Koekstrude Filmler</p>
    </div>
  </div>
  
  <section class="section">
    <div class="section-inner">
      <div class="product-intro">
        <Image src="/images/products/polinex-header-1.webp" alt="POLINEX" class="hero-image" width={168} height={168} />
        <Image src="/images/products/polinex-header-2.webp" alt="POLINEX" class="hero-image-secondary" width={168} height={168} />
        <Image src="/images/products/polinex-header-3.webp" alt="POLINEX" class="hero-image-tertiary" width={168} height={168} />
        <p>Gıda ambalajları ve genel kullanım amaçlı şeffaf veya beyaz ısıl yapışmalı koekstrude BOPP filmlerdir.</p>
        <ul>
          <li>Isıl yapışma sıcaklığı 115 ºC olan standart filmler, 75 ºC, 95 ºC`lerde yapışmaya başlayan geniş yapışma aralıklarına sahip filmler</li>
          <li>Hızlı paketleme makineleri için düşük sürtünmeli filmler</li>
          <li>Sigara paketlemeleri için özel filmler</li>
          <li>Tekstil ambalajları için düşük pusluluklu filmler</li>
          <li>Taze sebze ve meyve ambalajları için antifog-antibakteriyel özellikli filmler</li>
        </ul>
      </div>

      <div class="variants-list">
        {variants.map(variant => (
          <div class="variant-card">
            <div class="variant-header">
              <h2>{variant.code}</h2>
              {variant.image && <Image src={`/images/products/${variant.image.replace('.png', '.webp')}`} alt={variant.code} class="variant-image" width={150} height={150} />}
            </div>
            <p class="variant-description">{variant.description}</p>
            <h3>Özellikleri ve Kullanım alanları:</h3>
            <ul>
              {variant.features.map(feature => (
                <li>{feature}</li>
              ))}
            </ul>
            <p class="thickness"><strong>Üretilen Kalınlıklar (mikron):</strong> {variant.thickness}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #0e4a8a 0%, #1a5fa8 50%, #2a7fd4 100%);
    padding: 60px 24px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('https://static.wixstatic.com/media/d948a3_c9ba26606c5f46e68093f29b42c3db1c~mv2.jpg/v1/fill/w_980,h_425,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/d948a3_c9ba26606c5f46e68093f29b42c3db1c~mv2.jpg') center/cover no-repeat;
    opacity: 0.15;
  }
  .hero-image {
    position: relative;
    width: 168px;
    height: auto;
    object-fit: contain;
  }
  .hero-image-secondary {
    position: relative;
    width: 168px;
    height: auto;
    object-fit: contain;
  }
  .hero-image-tertiary {
    position: relative;
    width: 168px;
    height: auto;
    object-fit: contain;
  }
  .hero-content {
    position: relative;
    text-align: left;
  }
  .hero-content h1 {
    font-family: 'Montserrat', sans-serif;
    font-size: 42px;
    font-weight: 800;
    color: var(--white);
    margin-bottom: 8px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.3);
  }
  .hero-content p {
    color: rgba(255,255,255,0.9);
    font-size: 18px;
    line-height: 1.4;
  }
  .product-intro {
    background: var(--gray-bg);
    padding: 32px;
    border-radius: 10px;
    margin-bottom: 48px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .product-intro p {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 16px;
    flex: 1;
  }
  .product-intro ul {
    margin-left: 20px;
  }
  .product-intro li {
    margin-bottom: 8px;
    line-height: 1.6;
  }
  .variants-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .variant-card {
    background: var(--white);
    border-radius: 10px;
    padding: 32px;
    box-shadow: 0 3px 14px rgba(0,0,0,0.07);
  }
  .variant-card h2 {
    color: var(--blue-dark);
    font-size: 28px;
    margin-bottom: 16px;
  }
  .variant-header {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 20px;
  }
  .variant-image {
    width: 150px;
    height: auto;
    object-fit: contain;
  }
  .variant-description {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 20px;
    color: var(--text-color);
  }
  .variant-card h3 {
    color: var(--blue-dark);
    font-size: 18px;
    margin-bottom: 12px;
  }
  .variant-card ul {
    margin-left: 20px;
    margin-bottom: 16px;
  }
  .variant-card li {
    margin-bottom: 8px;
    line-height: 1.6;
  }
  .thickness {
    color: var(--text-light);
    font-size: 14px;
  }
  @media (max-width: 768px) {
    .page-hero {
      flex-direction: column;
      text-align: center;
    }
    .hero-content {
      text-align: center;
    }
    .hero-image {
      width: 150px;
    }
    .hero-content h1 {
      font-size: 32px;
    }
  }
</style>
