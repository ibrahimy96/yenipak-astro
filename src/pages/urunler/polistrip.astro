---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

export const prerender = true;
---

<Layout title="POLISTRIP - Açma Şeritleri" activePage="urunler">
  <div class="page-hero">
    <Image src="/images/products/polistrip.webp" alt="POLISTRIP" class="hero-image" width={200} height={200} />
    <div class="hero-content">
      <h1>POLISTRIP</h1>
      <p>Açma Şeritleri</p>
    </div>
  </div>
  
  <section class="section">
    <div class="section-inner">
      <div class="product-intro">
        <ul>
          <li>Geliştirilmiş, MOPP film (tek yöne gerdirilmiş polipropilen film)</li>
          <li>Değişik, renk, desen, uzunluk ve genişlikte üretilebilmektedir</li>
          <li>Sigara, çiklet, bisküvi, kaset ve CD paketlerinin kolay açılabilmesi için en pratik çözüm</li>
          <li>Ürünlerinizin taklit riskini ortadan kaldırmak için logonuzun basılı olduğu açma şeridini kullanabilirsiniz</li>
          <li>Yüksek hızlı paketleme makinelerinde mükemmel performans</li>
          <li>Geliştirilmiş tutkalı sayesinde, kağıt ve film gibi değişik ambalaj malzemeleri ile problemsiz çalışabilmektedir</li>
        </ul>
      </div>

      <div class="variants-list">
        <div class="variant-card">
          <h2>Polistrip</h2>
          <p class="variant-description">Kendinden yapışkanlı Açma Şeritleri.</p>
          <h3>Özellikleri ve Kullanım alanları:</h3>
          <ul>
            <li>Geliştirilmiş, MOPP (Tek yönde gerdirilmiş) film</li>
            <li>Sigara, ciklet, bisküvi, kaset ve CD paketlerinin kolay açılabilmesi için en pratik çözüm</li>
            <li>Yüksek hızlı paketleme makinelerinde mükemmel performans</li>
            <li>Geliştirilmiş tutkalı sayesinde kağıt ve film gibi değişik ambalaj malzemeleri ile problemsiz çalışabilmektedir</li>
            <li>Ürünlerin taklit edilme riskini kaldıran logolu baskı özelliği</li>
          </ul>
          
          <h3>Üretilen renkler:</h3>
          <p>Şeffaf, Kırmızı, Altın Sarısı ve Gümüş Rengi (isteğe bağlı değişik renkler)</p>
          
          <h3>Üretilen desenler:</h3>
          <p>Tamamı renkli, düz çizgili, noktalı, logolu (isteğe bağlı renk ve dizaynda)</p>
          
          <h3>Üretilen uzunluklar:</h3>
          <ul>
            <li>Sürekli Üretimler 6.000 m, 10.000 m</li>
            <li>Jumbo Bobinler 50.000 m, 75.000 m, 100.000 m, 150.000 m</li>
          </ul>
          
          <h3>Üretilen iç çap ölçüleri:</h3>
          <p>29 mm (standart) – 152 mm (jumbo)</p>
          
          <h3>Ürün Kodları:</h3>
          <ul>
            <li>SYO: Şeffaf</li>
            <li>SKR: Kırmızı</li>
            <li>SGL: Altın sarısı renkte çizgili</li>
            <li>SGR: Altın sarısı renkte full</li>
            <li>SNR: Gümüş renkli full</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #0e4a8a 0%, #1a5fa8 50%, #2a7fd4 100%);
    padding: 60px 24px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/hero-bg.jpg') center/cover no-repeat;
    opacity: 0.15;
  }
  .hero-image {
    position: relative;
    width: 200px;
    height: auto;
    object-fit: contain;
  }
  .hero-content {
    position: relative;
    text-align: left;
  }
  .hero-content h1 {
    font-family: 'Montserrat', sans-serif;
    font-size: 42px;
    font-weight: 800;
    color: var(--white);
    margin-bottom: 8px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.3);
  }
  .hero-content p {
    color: rgba(255,255,255,0.9);
    font-size: 18px;
    line-height: 1.4;
  }
  .product-intro {
    background: var(--gray-bg);
    padding: 32px;
    border-radius: 10px;
    margin-bottom: 48px;
  }
  .product-intro ul {
    margin-left: 20px;
  }
  .product-intro li {
    margin-bottom: 8px;
    line-height: 1.6;
  }
  .variants-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .variant-card {
    background: var(--white);
    border-radius: 10px;
    padding: 32px;
    box-shadow: 0 3px 14px rgba(0,0,0,0.07);
  }
  .variant-card h2 {
    color: var(--blue-dark);
    font-size: 28px;
    margin-bottom: 16px;
  }
  .variant-description {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 20px;
    color: var(--text-color);
  }
  .variant-card h3 {
    color: var(--blue-dark);
    font-size: 18px;
    margin-bottom: 12px;
    margin-top: 20px;
  }
  .variant-card ul {
    margin-left: 20px;
    margin-bottom: 16px;
  }
  .variant-card li {
    margin-bottom: 8px;
    line-height: 1.6;
  }
  .variant-card p {
    font-size: 16px;
    line-height: 1.6;
  }
  @media (max-width: 768px) {
    .page-hero {
      flex-direction: column;
      text-align: center;
    }
    .hero-content {
      text-align: center;
    }
    .hero-image {
      width: 150px;
    }
    .hero-content h1 {
      font-size: 32px;
    }
  }
</style>
